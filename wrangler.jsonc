{
  "name": "jyutjyu",
  "account_id": "9e0a4763181fe8362abab21f899f7ae2",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Free plan 不支援自訂 CPU 上限；升級 Paid（$5/月）後再打開：
  // "limits": { "cpu_ms": 30000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
    },
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "jyutjyu.com/*", "zone_name": "jyutjyu.com" },
    { "pattern": "www.jyutjyu.com/*", "zone_name": "jyutjyu.com" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jyutjyu",
      "database_id": "1a45931d-5323-457b-a39e-bf73dd841cde",
    },
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": [
      // Keep prerendered routes asset-first so Cloudflare can serve the built
      // HTML directly instead of paying a Worker invocation for every request.
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemaps/*",
    ],
  },
}
