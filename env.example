# ====================================
# 粤语辞丛 环境变量配置
# ====================================

# -----------------------------------
# 数据存储模式
# -----------------------------------
# true  = 强制使用 MongoDB API（推荐生产环境）
# false = 默认走静态 JSON，但客户端检测到 API 可用时会自动切换到 API
# 留空/不设置 = 自动模式（检测到 MONGODB_URI 时默认使用 API）
# NUXT_PUBLIC_USE_API=

# -----------------------------------
# SEO / Canonical 配置
# -----------------------------------
# 站点公开 URL（用于 canonical、sitemap、结构化数据）
NUXT_PUBLIC_SITE_URL=https://jyutjyu.com

# 是否在应用层强制重定向到所有非 canonical host（301）
# 默认仍会将常见的 www 别名重定向到 canonical host。
# 注意：如果你的托管平台已有相反方向的域名重定向，开启可能导致循环重定向
ENFORCE_CANONICAL_HOST_REDIRECT=false

# -----------------------------------
# MongoDB 配置（仅当 NUXT_PUBLIC_USE_API=true 时需要）
# -----------------------------------
# 从 MongoDB Atlas 获取连接字符串:
# https://cloud.mongodb.com/ → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# 数据库名称
MONGODB_DB_NAME=Jyutjyu

# -----------------------------------
# GitHub Issue 反馈（服务端创建 Issue）
# -----------------------------------
# 仓库（owner/repo 格式），例如：jyutjyucom/jyutjyu
GITHUB_REPO=
# GitHub Personal Access Token，最小权限 public_repo（私库需 repo）
GITHUB_TOKEN=

# -----------------------------------
# 预生成粤拼 TTS
# -----------------------------------
# 默认关闭。只有在 manifest 已生成且音频已上传后才开启。
NUXT_PUBLIC_TTS_ENABLED=false

# 客户端读取的 manifest / 音频基地址
NUXT_PUBLIC_TTS_MANIFEST_PATH=/tts/manifest.v1.json
NUXT_PUBLIC_TTS_BASE_URL=/tts/audio
NUXT_PUBLIC_TTS_VOICE_VERSION=v1

# 批量生成脚本使用的语音配置
TTS_VOICE_ID=yue-HK-Standard-A
TTS_VOICE_VERSION=v1

# 本地测试时可用：
# NUXT_PUBLIC_TTS_ENABLED=true
# NUXT_PUBLIC_TTS_MANIFEST_PATH=/tts/manifest.local.json
# npm run tts:sync:local -- --only "ngo5 dei6"
# 这会把少量 MP3 写到 public/tts/audio/...，并生成 public/tts/manifest.local.json，
# 方便本地 dev 直接播放而不污染生产 manifest。
# 如果未显式设置 NUXT_PUBLIC_TTS_*，本地 dev 会优先使用已有条目的
# public/tts/manifest.v1.json；只有在生产 manifest 不可用时，才会回退到
# manifest.local.json 这个 smoke manifest。
# 如果 public/tts/manifest.v1.json 已包含条目，生产构建在未显式设置
# NUXT_PUBLIC_TTS_ENABLED 时也会自动启用 TTS。

# 可选：同步脚本上传到 Cloudflare R2 的 bucket 名称
TTS_R2_BUCKET=

# 可选：将 TTS 音频上传到另一个 Cloudflare 账号的 R2
# 例如：your-cloudflare-account-id
TTS_R2_ACCOUNT_ID=

# 可选：绕过 Wrangler 逐文件上传，直接把音频 POST 到临时/自定义上传端点。
# 注意：这个路径通常会经过一个 Cloudflare Worker/Pages Function，
# 基本上会产生「每个音频对象一次 Worker 请求」。
# 在 Workers Free 账号上，大规模回填很容易打满每日请求额度。
# 只建议用于小规模 smoke test、断点补传或付费 Workers 账号。
# 对于完整回填，优先使用 TTS_R2_BUCKET / TTS_R2_ACCOUNT_ID 直传 R2。
TTS_UPLOAD_ENDPOINT=
TTS_UPLOAD_TOKEN=

# 可选：控制批量生成时的 Google TTS 吞吐。
TTS_CONCURRENCY=8
TTS_SYNTH_RPM=900
