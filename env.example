# ====================================
# 粤语辞丛 环境变量配置
# ====================================

# -----------------------------------
# 数据存储模式
# -----------------------------------
# true  = 强制使用 MongoDB API（推荐生产环境）
# false = 默认走静态 JSON，但客户端检测到 API 可用时会自动切换到 API
# 留空/不设置 = 自动模式（检测到 MONGODB_URI 时默认使用 API）
# NUXT_PUBLIC_USE_API=

# -----------------------------------
# SEO / Canonical 配置
# -----------------------------------
# 站点公开 URL（用于 canonical、sitemap、结构化数据）
NUXT_PUBLIC_SITE_URL=https://jyutjyu.com

# 是否在应用层强制重定向到所有非 canonical host（301）
# 默认仍会将常见的 www 别名重定向到 canonical host。
# 注意：如果你的托管平台已有相反方向的域名重定向，开启可能导致循环重定向
ENFORCE_CANONICAL_HOST_REDIRECT=false

# -----------------------------------
# MongoDB 配置（仅当 NUXT_PUBLIC_USE_API=true 时需要）
# -----------------------------------
# 从 MongoDB Atlas 获取连接字符串:
# https://cloud.mongodb.com/ → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# 数据库名称
MONGODB_DB_NAME=Jyutjyu

# -----------------------------------
# GitHub Issue 反馈（服务端创建 Issue）
# -----------------------------------
# 仓库（owner/repo 格式），例如：jyutjyucom/jyutjyu
GITHUB_REPO=
# GitHub Personal Access Token，最小权限 public_repo（私库需 repo）
GITHUB_TOKEN=
