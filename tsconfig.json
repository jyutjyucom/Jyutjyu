{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "watchOptions": {
    "excludeDirectories": [
      ".vercel",
      ".output",
      ".nuxt",
      "dist",
      "node_modules"
    ]
  }
}
